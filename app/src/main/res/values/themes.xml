<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.UnipiAudioStories" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="materialButtonStyle">@style/MyButtonAppStyle</item>
    </style>

    <style name="MyButtonAppStyle" parent="Widget.Material3.Button">
        <item name="cornerRadius">20dp</item> <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="BottomRoundedAppearance">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeBottomLeft">32dp</item>
        <item name="cornerSizeBottomRight">32dp</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
    </style>

    <style name="RoundedImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Theme.UnipiAudioStories" parent="Base.Theme.UnipiAudioStories" />
</resources>